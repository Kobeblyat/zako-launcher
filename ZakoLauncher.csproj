<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZakoLauncher</AssemblyName>
    <RootNamespace>ZakoLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fatcat.ico</ApplicationIcon>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- GMOD视频播放修复工具以资源方式嵌入启动器，运行时解压到本地数据目录 -->
    <EmbeddedResource Include="Tools\GModPatchTool.exe" LogicalName="ZakoLauncher.Tools.GModPatchTool.exe" />
  </ItemGroup>
</Project>
